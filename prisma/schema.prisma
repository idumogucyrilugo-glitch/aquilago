// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Booking {
  id            String    @id @default(cryptographic_uuid())
  userId        String?
  offerId       String
  orderId       String?   // From Duffel
  pnr           String?
  totalAmount   String
  currency      String
  status        String    @default("pending") // pending, confirmed, cancelled
  passengers    Passenger[]
  createdAt     DateTime  @default(now())
}

model Passenger {
  id          String  @id @default(cryptographic_uuid())
  bookingId   String
  title       String
  firstName   String
  lastName    String
  gender      String
  bornOn      String  // YYYY-MM-DD
  email       String?
  phone       String?
  booking     Booking @relation(fields: [bookingId], references: [id])
}